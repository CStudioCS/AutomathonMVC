--- /dev/null
+++ b/AutomathonUnity/Assets/Core/Engine/Utility/FixedPoint/FixedJsonConverters.cs
@@ -0,0 +1,75 @@
+using Newtonsoft.Json;
+using System;
+using System.Globalization;
+
+namespace Automathon
+{
+    /// <summary>
+    /// Serializes <see cref="Fixed"/> as a plain JSON number (ex: 1.5, -0.1, 12). <see cref="Fixed.ToString()"/> writes the
+    /// shortest decimal that converts back to the exact same value, so the round trip through JSON (and through Python
+    /// floats) is lossless. Reading accepts JSON integers, floats and numeric strings.
+    /// </summary>
+    public class FixedJsonConverter : JsonConverter
+    {
+        public override bool CanConvert(Type objectType) => objectType == typeof(Fixed) || objectType == typeof(Fixed?);
+
+        public override void WriteJson(JsonWriter writer, object value, JsonSerializer serializer)
+        {
+            if (value == null) { writer.WriteNull(); return; }
+            writer.WriteRawValue(((Fixed)value).ToString());
+        }
+
+        public override object ReadJson(JsonReader reader, Type objectType, object existingValue, JsonSerializer serializer)
+        {
+            switch (reader.TokenType)
+            {
+                case JsonToken.Null:
+                case JsonToken.Undefined:
+                    return objectType == typeof(Fixed?) ? (object)null : Fixed.Zero;
+                case JsonToken.Integer:
+                    if (reader.Value is System.Numerics.BigInteger big)
+                        return big.Sign > 0 ? Fixed.MaxValue : Fixed.MinValue;
+                    return (Fixed)Convert.ToInt64(reader.Value, CultureInfo.InvariantCulture);
+                case JsonToken.Float:
+                    if (reader.Value is decimal dec) return (Fixed)dec;
+                    return Fixed.FromDouble(Convert.ToDouble(reader.Value, CultureInfo.InvariantCulture));
+                case JsonToken.String:
+                    return Fixed.Parse((string)reader.Value);
+                default:
+                    throw new JsonSerializationException($"Unexpected token {reader.TokenType} when reading a Fixed number.");
+            }
+        }
+    }
+
+    /// <summary>Serializes <see cref="FixedLong"/> as a plain JSON number (up to 10 decimals).</summary>
+    public class FixedLongJsonConverter : JsonConverter
+    {
+        public override bool CanConvert(Type objectType) => objectType == typeof(FixedLong) || objectType == typeof(FixedLong?);
+
+        public override void WriteJson(JsonWriter writer, object value, JsonSerializer serializer)
+        {
+            if (value == null) { writer.WriteNull(); return; }
+            writer.WriteRawValue(((FixedLong)value).ToString());
+        }
+
+        public override object ReadJson(JsonReader reader, Type objectType, object existingValue, JsonSerializer serializer)
+        {
+            switch (reader.TokenType)
+            {
+                case JsonToken.Null:
+                case JsonToken.Undefined:
+                    return objectType == typeof(FixedLong?) ? (object)null : FixedLong.Zero;
+                case JsonToken.Integer:
+                    if (reader.Value is System.Numerics.BigInteger big)
+                        return big.Sign > 0 ? FixedLong.MaxValue : FixedLong.MinValue;
+                    return (FixedLong)Convert.ToInt64(reader.Value, CultureInfo.InvariantCulture);
+                case JsonToken.Float:
+                    return FixedLong.FromDouble(Convert.ToDouble(reader.Value, CultureInfo.InvariantCulture));
+                case JsonToken.String:
+                    return FixedLong.Parse((string)reader.Value);
+                default:
+                    throw new JsonSerializationException($"Unexpected token {reader.TokenType} when reading a FixedLong number.");
+            }
+        }
+    }
+}
diff --git a/AutomathonUnity/Assets/Core/Engine/Utility/FixedPoint/FixedLong.cs b/AutomathonUnity/Assets/Core/Engine/Utility/FixedPoint/FixedLong.cs
new file mode 100644
index 0000000..02eb170
--- /dev/null
+++ b/AutomathonUnity/Assets/Core/Engine/Utility/FixedPoint/FixedLong.cs
@@ -0,0 +1,241 @@
+using Newtonsoft.Json;
+using System;
+using System.Globalization;
+
+namespace Automathon
+{
+    /// <summary>
+    /// Deterministic 64-bit fixed point number in Q32.32 format, stored in a single <see cref="long"/>.
+    ///
+    /// <para>
+    /// This is the "wide" companion of <see cref="Fixed"/>: it has a much bigger range ([-2147483648, 2147483648[)
+    /// and precision (2^-32 ~ 0.00000000023). The product of two <see cref="Fixed"/> values always fits exactly
+    /// in a <see cref="FixedLong"/> (see <see cref="Multiply(Fixed, Fixed)"/>), which makes it the right type for
+    /// accumulations, squared lengths, dot/cross products, inverse masses... anything where Q16.16 would overflow or
+    /// lose too much precision.
+    /// </para>
+    /// <para>
+    /// It behaves like a <see cref="double"/>: implicit conversions from int, <see cref="Fixed"/>, float and double,
+    /// explicit conversion back to <see cref="Fixed"/> (rounded) and floating point types, and all the usual operators.
+    /// 128-bit intermediates are used for * and / so results are always correctly rounded. Overflows saturate.
+    /// </para>
+    /// </summary>
+    [Serializable]
+    [JsonConverter(typeof(FixedLongJsonConverter))]
+    public readonly struct FixedLong : IEquatable<FixedLong>, IComparable<FixedLong>, IComparable, IFormattable
+    {
+        public const int FRACTIONAL_BITS = 32;
+        public const long ONE_RAW = 1L << FRACTIONAL_BITS;
+        private const long HALF_RAW = ONE_RAW >> 1;
+        private const int SHIFT_FROM_FIXED = FRACTIONAL_BITS - Fixed.FRACTIONAL_BITS;
+
+        /// <summary>The underlying Q32.32 value, i.e. the represented number multiplied by 2^32.</summary>
+        public readonly long Raw;
+
+        private FixedLong(long raw) { Raw = raw; }
+
+        #region Constants
+
+        public static readonly FixedLong Zero = new FixedLong(0);
+        public static readonly FixedLong One = new FixedLong(ONE_RAW);
+        public static readonly FixedLong Half = new FixedLong(HALF_RAW);
+        public static readonly FixedLong MaxValue = new FixedLong(long.MaxValue);
+        public static readonly FixedLong MinValue = new FixedLong(long.MinValue);
+        public static readonly FixedLong Epsilon = new FixedLong(1);
+        public static readonly FixedLong Pi = new FixedLong(13493037705L);
+
+        #endregion
+
+        #region Construction / conversion
+
+        public static FixedLong FromRaw(long raw) => new FixedLong(raw);
+
+        public static FixedLong Ratio(long numerator, long denominator) => (FixedLong)numerator / (FixedLong)denominator;
+
+        /// <summary>Exact product of two Q16.16 numbers (no rounding at all).</summary>
+        public static FixedLong Multiply(Fixed a, Fixed b) => new FixedLong((long)a.Raw * b.Raw);
+
+        public static implicit operator FixedLong(int value) => new FixedLong((long)value << FRACTIONAL_BITS);
+        public static implicit operator FixedLong(Fixed value) => new FixedLong((long)value.Raw << SHIFT_FROM_FIXED);
+        public static implicit operator FixedLong(float value) => FromDouble(value);
+        public static implicit operator FixedLong(double value) => FromDouble(value);
+        public static explicit operator FixedLong(long value)
+            => value > int.MaxValue ? MaxValue : value < int.MinValue ? MinValue : new FixedLong(value << FRACTIONAL_BITS);
+
+        public static FixedLong FromDouble(double value)
+        {
+            if (double.IsNaN(value)) return Zero;
+            double scaled = value * ONE_RAW;
+            if (scaled >= long.MaxValue) return MaxValue;
+            if (scaled <= long.MinValue) return MinValue;
+            return new FixedLong((long)Math.Round(scaled, MidpointRounding.AwayFromZero));
+        }
+
+        /// <summary>Rounds to the nearest <see cref="Fixed"/> (saturating).</summary>
+        public static explicit operator Fixed(FixedLong value)
+        {
+            long raw = value.Raw;
+            long half = 1L << (SHIFT_FROM_FIXED - 1);
+            long shifted = raw > long.MaxValue - half ? long.MaxValue >> SHIFT_FROM_FIXED : (raw + half) >> SHIFT_FROM_FIXED;
+            return Fixed.FromRawSaturated(shifted);
+        }
+
+        public static explicit operator int(FixedLong value) => (int)(value.Raw / ONE_RAW);
+        public static explicit operator long(FixedLong value) => value.Raw / ONE_RAW;
+        public static explicit operator float(FixedLong value) => (float)((double)value);
+        public static explicit operator double(FixedLong value)
+        {
+            // split to keep the full precision of the integer part
+            long integer = value.Raw >> FRACTIONAL_BITS;
+            long fraction = value.Raw & (ONE_RAW - 1);
+            return integer + fraction / (double)ONE_RAW;
+        }
+
+        public Fixed ToFixed() => (Fixed)this;
+        public float ToFloat() => (float)this;
+        public double ToDouble() => (double)this;
+
+        #endregion
+
+        #region Operators
+
+        public static FixedLong operator +(FixedLong a) => a;
+        public static FixedLong operator -(FixedLong a) => a.Raw == long.MinValue ? MaxValue : new FixedLong(-a.Raw);
+
+        public static FixedLong operator +(FixedLong a, FixedLong b)
+        {
+            long r = unchecked(a.Raw + b.Raw);
+            if (((a.Raw ^ r) & (b.Raw ^ r)) < 0) // both operands have the same sign and the result doesn't
+                return a.Raw < 0 ? MinValue : MaxValue;
+            return new FixedLong(r);
+        }
+
+        public static FixedLong operator -(FixedLong a, FixedLong b)
+        {
+            long r = unchecked(a.Raw - b.Raw);
+            if (((a.Raw ^ b.Raw) & (a.Raw ^ r)) < 0)
+                return a.Raw < 0 ? MinValue : MaxValue;
+            return new FixedLong(r);
+        }
+
+        public static FixedLong operator *(FixedLong a, FixedLong b)
+        {
+            bool negative = (a.Raw < 0) != (b.Raw < 0);
+            ulong ua = UInt128Math.Abs(a.Raw);
+            ulong ub = UInt128Math.Abs(b.Raw);
+
+            UInt128Math.Multiply(ua, ub, out ulong hi, out ulong lo);
+            UInt128Math.Add(ref hi, ref lo, (ulong)HALF_RAW); // round to nearest
+            UInt128Math.ShiftRight(ref hi, ref lo, FRACTIONAL_BITS);
+
+            return FromMagnitude(hi, lo, negative);
+        }
+
+        public static FixedLong operator /(FixedLong a, FixedLong b)
+        {
+            if (b.Raw == 0)
+                return a.Raw > 0 ? MaxValue : a.Raw < 0 ? MinValue : Zero;
+
+            bool negative = (a.Raw < 0) != (b.Raw < 0);
+            ulong ua = UInt128Math.Abs(a.Raw);
+            ulong ub = UInt128Math.Abs(b.Raw);
+
+            // (ua << 32) / ub on 128 bits
+            ulong hi = ua >> (64 - FRACTIONAL_BITS);
+            ulong lo = ua << FRACTIONAL_BITS;
+            UInt128Math.Divide(hi, lo, ub, out ulong qHi, out ulong qLo, out ulong rem);
+
+            if (rem >= ub - rem) // rem * 2 >= ub, round half away from zero
+                UInt128Math.Add(ref qHi, ref qLo, 1);
+
+            return FromMagnitude(qHi, qLo, negative);
+        }
+
+        public static FixedLong operator %(FixedLong a, FixedLong b)
+            => b.Raw == 0 || (b.Raw == -1) ? Zero : new FixedLong(a.Raw % b.Raw);
+
+        private static FixedLong FromMagnitude(ulong hi, ulong lo, bool negative)
+        {
+            if (negative)
+            {
+                if (hi != 0 || lo > (ulong)long.MaxValue + 1UL) return MinValue;
+                return new FixedLong(unchecked(-(long)lo));
+            }
+
+            if (hi != 0 || lo > long.MaxValue) return MaxValue;
+            return new FixedLong((long)lo);
+        }
+
+        public static bool operator ==(FixedLong a, FixedLong b) => a.Raw == b.Raw;
+        public static bool operator !=(FixedLong a, FixedLong b) => a.Raw != b.Raw;
+        public static bool operator <(FixedLong a, FixedLong b) => a.Raw < b.Raw;
+        public static bool operator >(FixedLong a, FixedLong b) => a.Raw > b.Raw;
+        public static bool operator <=(FixedLong a, FixedLong b) => a.Raw <= b.Raw;
+        public static bool operator >=(FixedLong a, FixedLong b) => a.Raw >= b.Raw;
+
+        #endregion
+
+        #region Helpers
+
+        public FixedLong Abs() => Raw < 0 ? -this : this;
+        public int Sign() => Raw > 0 ? 1 : Raw < 0 ? -1 : 0;
+
+        #endregion
+
+        #region Equality / comparison / formatting
+
+        public bool Equals(FixedLong other) => Raw == other.Raw;
+        public override bool Equals(object obj) => obj is FixedLong other && Equals(other);
+        public override int GetHashCode() => Raw.GetHashCode();
+        public int CompareTo(FixedLong other) => Raw.CompareTo(other.Raw);
+        public int CompareTo(object obj)
+        {
+            if (obj == null) return 1;
+            if (obj is FixedLong other) return CompareTo(other);
+            throw new ArgumentException("Object must be of type FixedLong");
+        }
+
+        /// <summary>Decimal representation (up to 10 decimals, '.' separator, no exponent).</summary>
+        public override string ToString()
+        {
+            bool negative = Raw < 0;
+            ulong abs = UInt128Math.Abs(Raw);
+            ulong integerPart = abs >> FRACTIONAL_BITS;
+            ulong fraction = abs & ((ulong)ONE_RAW - 1UL);
+
+            // 10 rounded decimals: fraction * 10^10 / 2^32 computed on 128 bits
+            const ulong POW10 = 10000000000UL;
+            UInt128Math.Multiply(fraction, POW10, out ulong hi, out ulong lo);
+            UInt128Math.Add(ref hi, ref lo, 1UL << (FRACTIONAL_BITS - 1));
+            UInt128Math.ShiftRight(ref hi, ref lo, FRACTIONAL_BITS);
+            ulong decimals = lo;
+            if (decimals >= POW10) { integerPart++; decimals -= POW10; }
+
+            string decimalString = decimals.ToString(CultureInfo.InvariantCulture).PadLeft(10, '0').TrimEnd('0');
+            string result = integerPart.ToString(CultureInfo.InvariantCulture);
+            if (decimalString.Length > 0) result += "." + decimalString;
+            return negative && (integerPart != 0 || decimals != 0) ? "-" + result : result;
+        }
+
+        public string ToString(string format, IFormatProvider formatProvider)
+            => string.IsNullOrEmpty(format) ? ToString() : ((double)this).ToString(format, formatProvider);
+
+        public static FixedLong Parse(string s)
+        {
+            if (decimal.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out decimal dec))
+            {
+                // decimal can't hold value * 2^32 for big values, so do integer and fractional parts separately
+                decimal integer = decimal.Truncate(dec);
+                if (integer >= int.MaxValue + 1m) return MaxValue;
+                if (integer < int.MinValue) return MinValue;
+                decimal fraction = (dec - integer) * ONE_RAW;
+                return new FixedLong(((long)integer << FRACTIONAL_BITS) + (long)Math.Round(fraction, MidpointRounding.AwayFromZero));
+            }
+            if (double.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out double d))
+                return FromDouble(d);
+            throw new FormatException($"'{s}' is not a valid FixedLong number");
+        }
+
+        #endregion
+    }
+}
diff --git a/AutomathonUnity/Assets/Core/Engine/Utility/FixedPoint/FixedMath.cs b/AutomathonUnity/Assets/Core/Engine/Utility/FixedPoint/FixedMath.cs
new file mode 100644
index 0000000..8af29c0
--- /dev/null
+++ b/AutomathonUnity/Assets/Core/Engine/Utility/FixedPoint/FixedMath.cs
@@ -0,0 +1,281 @@
+namespace Automathon
+{
+    /// <summary>
+    /// Deterministic math functions for <see cref="Fixed"/> and <see cref="FixedLong"/> (the fixed point equivalent of
+    /// System.Math / UnityEngine.Mathf). Everything is computed with integer arithmetic only, so results are bit-for-bit
+    /// identical on every platform. Angles are in radians.
+    /// </summary>
+    public static class FixedMath
+    {
+        public static readonly Fixed Pi = Fixed.Pi;
+        public static readonly Fixed HalfPi = Fixed.HalfPi;
+        public static readonly Fixed TwoPi = Fixed.TwoPi;
+
+        #region Basic helpers
+
+        public static Fixed Abs(Fixed value) => value.Abs();
+        public static FixedLong Abs(FixedLong value) => value.Abs();
+        public static int Sign(Fixed value) => value.Sign();
+        public static int Sign(FixedLong value) => value.Sign();
+
+        public static Fixed Min(Fixed a, Fixed b) => a < b ? a : b;
+        public static Fixed Max(Fixed a, Fixed b) => a > b ? a : b;
+        public static FixedLong Min(FixedLong a, FixedLong b) => a < b ? a : b;
+        public static FixedLong Max(FixedLong a, FixedLong b) => a > b ? a : b;
+
+        public static Fixed Clamp(Fixed value, Fixed min, Fixed max) => value < min ? min : value > max ? max : value;
+        public static FixedLong Clamp(FixedLong value, FixedLong min, FixedLong max) => value < min ? min : value > max ? max : value;
+        public static Fixed Clamp01(Fixed value) => Clamp(value, Fixed.Zero, Fixed.One);
+
+        public static Fixed Floor(Fixed value) => Fixed.FromRaw(value.Raw & ~(Fixed.ONE_RAW - 1));
+        public static Fixed Ceiling(Fixed value) => -Floor(-value);
+        /// <summary>Rounds to the nearest integer, halfway values are rounded away from zero.</summary>
+        public static Fixed Round(Fixed value) => Fixed.FromInt(value.RoundToInt());
+        public static Fixed Truncate(Fixed value) => Fixed.FromInt((int)value);
+
+        public static Fixed Lerp(Fixed a, Fixed b, Fixed t) => a + (b - a) * Clamp01(t);
+        public static Fixed LerpUnclamped(Fixed a, Fixed b, Fixed t) => a + (b - a) * t;
+
+        public static Fixed MoveTowards(Fixed current, Fixed target, Fixed maxDelta)
+            => Abs(target - current) <= maxDelta ? target : current + maxDelta * Sign(target - current);
+
+        #endregion
+
+        #region Square root
+
+        /// <summary>Square root rounded to the nearest representable value. Negative inputs return 0.</summary>
+        public static Fixed Sqrt(Fixed value)
+        {
+            if (value.Raw <= 0) return Fixed.Zero;
+            // sqrt(raw / 2^16) * 2^16 == sqrt(raw * 2^16)
+            return Fixed.FromRawSaturated((long)SqrtRounded((ulong)value.Raw << Fixed.FRACTIONAL_BITS));
+        }
+
+        /// <summary>Square root rounded to the nearest representable value. Negative inputs return 0.</summary>
+        public static FixedLong Sqrt(FixedLong value)
+        {
+            if (value.Raw <= 0) return FixedLong.Zero;
+            // sqrt(raw / 2^32) * 2^32 == sqrt(raw * 2^32), computed on 128 bits
+            ulong raw = (ulong)value.Raw;
+            ulong hi = raw >> 32, lo = raw << 32;
+            ulong root = UInt128Math.Sqrt(hi, lo);
+
+            // round to nearest: compare n with root^2 + root (= (root + 0.5)^2 - 0.25)
+            UInt128Math.Multiply(root, root, out ulong sqHi, out ulong sqLo);
+            UInt128Math.Add(ref sqHi, ref sqLo, root);
+            if (hi > sqHi || (hi == sqHi && lo > sqLo))
+                root++;
+
+            return FixedLong.FromRaw((long)root);
+        }
+
+        /// <summary>Square root of an exact Q32.32 value (ex: a squared length) returned as a Q16.16 <see cref="Fixed"/>.</summary>
+        public static Fixed SqrtToFixed(FixedLong value)
+        {
+            if (value.Raw <= 0) return Fixed.Zero;
+            // sqrt(raw / 2^32) * 2^16 == sqrt(raw)
+            return Fixed.FromRawSaturated((long)SqrtRounded((ulong)value.Raw));
+        }
+
+        /// <summary>round(sqrt(n)) for 64-bit integers.</summary>
+        internal static ulong SqrtRounded(ulong n)
+        {
+            ulong root = UInt128Math.Sqrt(n);
+            // n > root^2 + root  <=>  sqrt(n) > root + 0.5 (n integer)
+            if (n - root * root > root) root++;
+            return root;
+        }
+
+        #endregion
+
+        #region Trigonometry (CORDIC, Q30 internal precision)
+
+        private const int Q30_BITS = 30;
+        private const int Q30_TO_Q16 = Q30_BITS - Fixed.FRACTIONAL_BITS;
+        private const long PI_Q30 = 3373259426L;
+        private const long HALF_PI_Q30 = 1686629713L;
+        private const long TWO_PI_Q30 = 6746518852L;
+        private const long CORDIC_GAIN_INV_Q30 = 652032874L; // prod(1 / sqrt(1 + 2^-2i)) * 2^30
+        private const int CORDIC_ITERATIONS = 30;
+
+        // atan(2^-i) * 2^30
+        private static readonly long[] AtanTable = new long[]
+        {
+            843314857L, 497837829L, 263043837L, 133525159L, 67021687L, 33543516L, 16775851L, 8388437L,
+            4194283L, 2097149L, 1048576L, 524288L, 262144L, 131072L, 65536L, 32768L,
+            16384L, 8192L, 4096L, 2048L, 1024L, 512L, 256L, 128L,
+            64L, 32L, 16L, 8L, 4L, 2L, 1L
+        };
+
+        private static int Q30ToFixedRaw(long q30) => (int)((q30 + (1L << (Q30_TO_Q16 - 1))) >> Q30_TO_Q16);
+
+        /// <summary>Computes both sine and cosine of an angle (radians) at once.</summary>
+        public static void SinCos(Fixed angle, out Fixed sin, out Fixed cos)
+        {
+            // Reduce to [-pi, pi] in Q30
+            long z = ((long)angle.Raw << Q30_TO_Q16) % TWO_PI_Q30;
+            if (z > PI_Q30) z -= TWO_PI_Q30;
+            else if (z < -PI_Q30) z += TWO_PI_Q30;
+
+            // Reduce to [-pi/2, pi/2], CORDIC only converges there. cos/sin(z +- pi) = -cos/sin(z)
+            bool negate = false;
+            if (z > HALF_PI_Q30) { z -= PI_Q30; negate = true; }
+            else if (z < -HALF_PI_Q30) { z += PI_Q30; negate = true; }
+
+            // CORDIC in rotation mode
+            long x = CORDIC_GAIN_INV_Q30;
+            long y = 0;
+            for (int i = 0; i < CORDIC_ITERATIONS; i++)
+            {
+                long xShift = x >> i;
+                long yShift = y >> i;
+                if (z >= 0)
+                {
+                    x -= yShift;
+                    y += xShift;
+                    z -= AtanTable[i];
+                }
+                else
+                {
+                    x += yShift;
+                    y -= xShift;
+                    z += AtanTable[i];
+                }
+            }
+
+            if (negate) { x = -x; y = -y; }
+
+            // Clamp the tiny CORDIC overshoots so |sin|, |cos| <= 1
+            const long ONE_Q30 = 1L << Q30_BITS;
+            if (x > ONE_Q30) x = ONE_Q30; else if (x < -ONE_Q30) x = -ONE_Q30;
+            if (y > ONE_Q30) y = ONE_Q30; else if (y < -ONE_Q30) y = -ONE_Q30;
+
+            cos = Fixed.FromRaw(Q30ToFixedRaw(x));
+            sin = Fixed.FromRaw(Q30ToFixedRaw(y));
+        }
+
+        public static Fixed Sin(Fixed angle)
+        {
+            SinCos(angle, out Fixed sin, out _);
+            return sin;
+        }
+
+        public static Fixed Cos(Fixed angle)
+        {
+            SinCos(angle, out _, out Fixed cos);
+            return cos;
+        }
+
+        /// <summary>Tangent. Saturates near +-pi/2.</summary>
+        public static Fixed Tan(Fixed angle)
+        {
+            SinCos(angle, out Fixed sin, out Fixed cos);
+            return sin / cos;
+        }
+
+        /// <summary>
+        /// Angle (radians, in ]-pi, pi]) of the vector (x, y), same convention as Math.Atan2(y, x). Atan2(0, 0) == 0.
+        /// </summary>
+        public static Fixed Atan2(Fixed y, Fixed x) => Atan2Raw(y.Raw, x.Raw);
+
+        /// <summary>Same as <see cref="Atan2(Fixed, Fixed)"/> but for <see cref="FixedLong"/> coordinates.</summary>
+        public static Fixed Atan2(FixedLong y, FixedLong x) => Atan2Raw(y.Raw, x.Raw);
+
+        private static Fixed Atan2Raw(long yRaw, long xRaw)
+        {
+            if (xRaw == 0)
+            {
+                if (yRaw > 0) return Fixed.HalfPi;
+                if (yRaw < 0) return -Fixed.HalfPi;
+                return Fixed.Zero;
+            }
+            if (yRaw == 0)
+                return xRaw > 0 ? Fixed.Zero : Fixed.Pi;
+
+            // Work in the right half plane: atan2(y, x) = atan2(-y, -x) +- pi when x < 0.
+            // Huge values are pre-shifted down to stay away from overflow (CORDIC gain is ~1.65).
+            long x = xRaw, y = yRaw;
+            const long LIMIT = 1L << 60;
+            if (x >= LIMIT || x <= -LIMIT || y >= LIMIT || y <= -LIMIT)
+            {
+                x >>= 2;
+                y >>= 2;
+            }
+            long correction = 0;
+            if (x < 0)
+            {
+                x = -x;
+                y = -y;
+                correction = yRaw >= 0 ? PI_Q30 : -PI_Q30;
+            }
+
+            // Scale up to use the full precision (results only depend on the ratio y/x)
+            long absY = y < 0 ? -y : y;
+            long maxAbs = x > absY ? x : absY;
+            while (maxAbs < (1L << 58))
+            {
+                x <<= 1;
+                y <<= 1;
+                maxAbs <<= 1;
+            }
+
+            // CORDIC in vectoring mode: rotate (x, y) towards the x axis and accumulate the angle
+            long angle = 0;
+            for (int i = 0; i < CORDIC_ITERATIONS; i++)
+            {
+                long xShift = x >> i;
+                long yShift = y >> i;
+                if (y >= 0)
+                {
+                    x += yShift;
+                    y -= xShift;
+                    angle += AtanTable[i];
+                }
+                else
+                {
+                    x -= yShift;
+                    y += xShift;
+                    angle -= AtanTable[i];
+                }
+            }
+
+            angle += correction;
+            if (angle > PI_Q30) angle -= TWO_PI_Q30;
+            if (angle <= -PI_Q30) angle += TWO_PI_Q30;
+
+            return Fixed.FromRaw(Q30ToFixedRaw(angle));
+        }
+
+        public static Fixed Atan(Fixed value) => Atan2(value, Fixed.One);
+
+        /// <summary>Arc sine, input is clamped to [-1, 1].</summary>
+        public static Fixed Asin(Fixed value)
+        {
+            value = Clamp(value, Fixed.NegativeOne, Fixed.One);
+            FixedLong cos = Sqrt(FixedLong.One - FixedLong.Multiply(value, value));
+            return Atan2((FixedLong)value, cos);
+        }
+
+        /// <summary>Arc cosine, input is clamped to [-1, 1].</summary>
+        public static Fixed Acos(Fixed value)
+        {
+            value = Clamp(value, Fixed.NegativeOne, Fixed.One);
+            FixedLong sin = Sqrt(FixedLong.One - FixedLong.Multiply(value, value));
+            return Atan2(sin, (FixedLong)value);
+        }
+
+        /// <summary>Wraps an angle to ]-pi, pi].</summary>
+        public static Fixed WrapAngle(Fixed angle)
+        {
+            Fixed wrapped = angle % Fixed.TwoPi;
+            if (wrapped > Fixed.Pi) wrapped -= Fixed.TwoPi;
+            else if (wrapped <= -Fixed.Pi) wrapped += Fixed.TwoPi;
+            return wrapped;
+        }
+
+        /// <summary>Shortest signed difference between two angles, in ]-pi, pi].</summary>
+        public static Fixed DeltaAngle(Fixed from, Fixed to) => WrapAngle(to - from);
+
+        #endregion
+    }
+}
diff --git a/AutomathonUnity/Assets/Core/Engine/Utility/FixedPoint/FixedVector2.cs b/AutomathonUnity/Assets/Core/Engine/Utility/FixedPoint/FixedVector2.cs
new file mode 100644
index 0000000..3e3d02d
--- /dev/null
+++ b/AutomathonUnity/Assets/Core/Engine/Utility/FixedPoint/FixedVector2.cs
@@ -0,0 +1,220 @@
+using System;
+
+namespace Automathon
+{
+    /// <summary>
+    /// 2D vector made of two <see cref="Fixed"/> components. Works like UnityEngine.Vector2 / System.Numerics.Vector2,
+    /// but every operation is deterministic. World space is expressed in Unity units (1 = 1 Unity unit).
+    ///
+    /// <para>
+    /// Products that would lose precision in Q16.16 (dot, cross, squared lengths) are computed exactly on 64 bits
+    /// internally; the *Long variants give the exact <see cref="FixedLong"/> result.
+    /// </para>
+    /// Only the X and Y fields are serialized (everything else is a method), so its JSON form is {"X": 1.5, "Y": -2}.
+    /// </summary>
+    [Serializable]
+    public struct FixedVector2 : IEquatable<FixedVector2>
+    {
+        public Fixed X;
+        public Fixed Y;
+
+        public FixedVector2(Fixed x, Fixed y)
+        {
+            X = x;
+            Y = y;
+        }
+
+        #region Constants
+
+        public static FixedVector2 Zero => new FixedVector2(Fixed.Zero, Fixed.Zero);
+        public static FixedVector2 One => new FixedVector2(Fixed.One, Fixed.One);
+        public static FixedVector2 Up => new FixedVector2(Fixed.Zero, Fixed.One);
+        public static FixedVector2 Down => new FixedVector2(Fixed.Zero, Fixed.NegativeOne);
+        public static FixedVector2 Right => new FixedVector2(Fixed.One, Fixed.Zero);
+        public static FixedVector2 Left => new FixedVector2(Fixed.NegativeOne, Fixed.Zero);
+
+        #endregion
+
+        #region Operators
+
+        public static FixedVector2 operator +(FixedVector2 a, FixedVector2 b) => new FixedVector2(a.X + b.X, a.Y + b.Y);
+        public static FixedVector2 operator -(FixedVector2 a, FixedVector2 b) => new FixedVector2(a.X - b.X, a.Y - b.Y);
+        public static FixedVector2 operator -(FixedVector2 a) => new FixedVector2(-a.X, -a.Y);
+        public static FixedVector2 operator *(FixedVector2 a, Fixed b) => new FixedVector2(a.X * b, a.Y * b);
+        public static FixedVector2 operator *(Fixed a, FixedVector2 b) => new FixedVector2(a * b.X, a * b.Y);
+        public static FixedVector2 operator /(FixedVector2 a, Fixed b) => new FixedVector2(a.X / b, a.Y / b);
+
+        /// <summary>Scales by a wide scalar; the multiplication is done in Q32.32 and rounded once.</summary>
+        public static FixedVector2 operator *(FixedVector2 a, FixedLong b) => new FixedVector2((Fixed)(a.X * b), (Fixed)(a.Y * b));
+        public static FixedVector2 operator *(FixedLong a, FixedVector2 b) => b * a;
+        public static FixedVector2 operator /(FixedVector2 a, FixedLong b) => new FixedVector2((Fixed)(a.X / b), (Fixed)(a.Y / b));
+
+        /// <summary>Component-wise product.</summary>
+        public static FixedVector2 Scale(FixedVector2 a, FixedVector2 b) => new FixedVector2(a.X * b.X, a.Y * b.Y);
+
+        public static bool operator ==(FixedVector2 a, FixedVector2 b) => a.X == b.X && a.Y == b.Y;
+        public static bool operator !=(FixedVector2 a, FixedVector2 b) => !(a == b);
+
+        #endregion
+
+        #region Products / lengths
+
+        /// <summary>Exact dot product in Q32.32.</summary>
+        public FixedLong DotLong(FixedVector2 other)
+            => FixedLong.Multiply(X, other.X) + FixedLong.Multiply(Y, other.Y);
+
+        /// <summary>Dot product (computed exactly, rounded once).</summary>
+        public Fixed Dot(FixedVector2 other) => (Fixed)DotLong(other);
+
+        public static Fixed Dot(FixedVector2 a, FixedVector2 b) => a.Dot(b);
+
+        /// <summary>Exact 2D cross product (z component of the 3D cross product) in Q32.32.</summary>
+        public FixedLong CrossLong(FixedVector2 other)
+            => FixedLong.Multiply(X, other.Y) - FixedLong.Multiply(Y, other.X);
+
+        /// <summary>2D cross product X * other.Y - Y * other.X (computed exactly, rounded once).</summary>
+        public Fixed Cross(FixedVector2 other) => (Fixed)CrossLong(other);
+
+        public static Fixed Cross(FixedVector2 a, FixedVector2 b) => a.Cross(b);
+
+        public FixedLong LengthSquaredLong() => DotLong(this);
+        public Fixed LengthSquared() => (Fixed)LengthSquaredLong();
+
+        public Fixed Length()
+        {
+            // raw sum of squares is exactly length^2 in Q32.32 and fits in an ulong, its integer sqrt is length in Q16.16
+            ulong sum = (ulong)((long)X.Raw * X.Raw) + (ulong)((long)Y.Raw * Y.Raw);
+            return Fixed.FromRawSaturated((long)FixedMath.SqrtRounded(sum));
+        }
+
+        public static Fixed Distance(FixedVector2 a, FixedVector2 b) => (a - b).Length();
+        public static Fixed DistanceSquared(FixedVector2 a, FixedVector2 b) => (a - b).LengthSquared();
+
+        #endregion
+
+        #region Normalization
+
+        /// <summary>Unit vector with the same direction. The zero vector stays zero.</summary>
+        public FixedVector2 Normalized()
+        {
+            long x = X.Raw, y = Y.Raw;
+            if (x == 0 && y == 0) return Zero;
+
+            // Bring the biggest component around 2^30 so that the computation keeps full precision even for tiny
+            // vectors (and doesn't overflow for huge ones). The direction only depends on the x/y ratio.
+            long maxAbs = Math.Max(Math.Abs(x), Math.Abs(y));
+            while (maxAbs < (1L << 29)) { x <<= 1; y <<= 1; maxAbs <<= 1; }
+
+            long length = (long)FixedMath.SqrtRounded((ulong)(x * x) + (ulong)(y * y)); // < 2^31.5
+            return new FixedVector2(
+                Fixed.FromRawSaturated(Fixed.RoundedDivide(x << Fixed.FRACTIONAL_BITS, length)),
+                Fixed.FromRawSaturated(Fixed.RoundedDivide(y << Fixed.FRACTIONAL_BITS, length)));
+        }
+
+        /// <summary>Normalizes this vector in place (like UnityEngine.Vector2.Normalize).</summary>
+        public void Normalize() => this = Normalized();
+
+        /// <summary>Returns a copy whose length is at most maxLength.</summary>
+        public FixedVector2 ClampMagnitude(Fixed maxLength)
+        {
+            if (LengthSquaredLong() <= FixedLong.Multiply(maxLength, maxLength))
+                return this;
+            return Normalized() * maxLength;
+        }
+
+        #endregion
+
+        #region Geometry
+
+        public FixedVector2 OrthogonalClockwise() => new FixedVector2(Y, -X);
+        public FixedVector2 OrthogonalCounterClockwise() => new FixedVector2(-Y, X);
+
+        /// <summary>Unit vector pointing in the direction of the given angle (radians): (cos, sin).</summary>
+        public static FixedVector2 FromAngle(Fixed radians)
+        {
+            FixedMath.SinCos(radians, out Fixed sin, out Fixed cos);
+            return new FixedVector2(cos, sin);
+        }
+
+        /// <summary>Angle of this vector in radians, in ]-pi, pi] (0 for the zero vector).</summary>
+        public Fixed Angle() => FixedMath.Atan2(Y, X);
+
+        public FixedVector2 Rotated(Fixed radians)
+        {
+            FixedMath.SinCos(radians, out Fixed sin, out Fixed cos);
+            return new FixedVector2(
+                (Fixed)(FixedLong.Multiply(X, cos) - FixedLong.Multiply(Y, sin)),
+                (Fixed)(FixedLong.Multiply(X, sin) + FixedLong.Multiply(Y, cos)));
+        }
+
+        public FixedVector2 ProjectedOn(FixedVector2 other)
+        {
+            FixedLong otherLengthSquared = other.LengthSquaredLong();
+            if (otherLengthSquared == FixedLong.Zero)
+                return Zero;
+
+            return other * (DotLong(other) / otherLengthSquared);
+        }
+
+        public static FixedVector2 Lerp(FixedVector2 a, FixedVector2 b, Fixed t)
+        {
+            t = FixedMath.Clamp01(t);
+            return a + (b - a) * t;
+        }
+
+        /// <summary>
+        /// If the projection of this point on the (bound1, bound2) line falls outside of the segment, moves it back
+        /// on the segment's end (along the segment's normal). Otherwise returns the point unchanged.
+        /// </summary>
+        public FixedVector2 ClipBetween(FixedVector2 bound1, FixedVector2 bound2)
+        {
+            FixedVector2 segment = bound2 - bound1;
+            FixedLong lengthSquared = segment.LengthSquaredLong();
+            if (lengthSquared == FixedLong.Zero) return this;
+
+            FixedLong scal = segment.DotLong(this - bound1);
+            FixedVector2 projOnNormal = (this - bound1).ProjectedOn(segment.OrthogonalCounterClockwise());
+
+            if (scal <= FixedLong.Zero)
+                return projOnNormal + bound1;
+            else if (scal >= lengthSquared)
+                return projOnNormal + bound2;
+            return this;
+        }
+
+        /// <summary>Closest point to this one on the segment [linePoint1, linePoint2].</summary>
+        public FixedVector2 GetClosestOnSegment(FixedVector2 linePoint1, FixedVector2 linePoint2)
+        {
+            FixedVector2 segment = linePoint2 - linePoint1;
+            FixedLong lengthSquared = segment.LengthSquaredLong();
+            if (lengthSquared == FixedLong.Zero) return linePoint1;
+
+            FixedLong scal = segment.DotLong(this - linePoint1);
+
+            if (scal <= FixedLong.Zero)
+                return linePoint1;
+            else if (scal >= lengthSquared)
+                return linePoint2;
+            return linePoint1 + segment * (scal / lengthSquared);
+        }
+
+        #endregion
+
+        #region Conversions / equality
+
+        public static FixedVector2 FromDouble(double x, double y) => new FixedVector2(Fixed.FromDouble(x), Fixed.FromDouble(y));
+
+        public bool Equals(FixedVector2 other) => this == other;
+        public override bool Equals(object obj) => obj is FixedVector2 other && Equals(other);
+        public override int GetHashCode() => HashCode.Combine(X.Raw, Y.Raw);
+        public override string ToString() => $"({X}, {Y})";
+
+        public void Deconstruct(out Fixed x, out Fixed y)
+        {
+            x = X;
+            y = Y;
+        }
+
+        #endregion
+    }
+}
diff --git a/AutomathonUnity/Assets/Core/Engine/Utility/FixedPoint/UInt128Math.cs b/AutomathonUnity/Assets/Core/Engine/Utility/FixedPoint/UInt128Math.cs
new file mode 100644
index 0000000..8e52744
--- /dev/null
+++ b/AutomathonUnity/Assets/Core/Engine/Utility/FixedPoint/UInt128Math.cs
@@ -0,0 +1,132 @@
+namespace Automathon
+{
+    /// <summary>
+    /// Minimal unsigned 128-bit helpers used by <see cref="FixedLong"/> and <see cref="FixedMath"/>.
+    /// System.Int128 / Math.BigMul(long, long) are not available in Unity (.NET Standard 2.1), so this is done by hand.
+    /// Every function is pure integer arithmetic, hence deterministic.
+    /// </summary>
+    internal static class UInt128Math
+    {
+        /// <summary>Full 64x64 -> 128 bit unsigned product.</summary>
+        public static void Multiply(ulong a, ulong b, out ulong hi, out ulong lo)
+        {
+            ulong aLo = a & 0xFFFFFFFFUL, aHi = a >> 32;
+            ulong bLo = b & 0xFFFFFFFFUL, bHi = b >> 32;
+
+            ulong loLo = aLo * bLo;
+            ulong hiLo = aHi * bLo;
+            ulong loHi = aLo * bHi;
+            ulong hiHi = aHi * bHi;
+
+            ulong cross = (loLo >> 32) + (hiLo & 0xFFFFFFFFUL) + loHi; // cannot overflow
+            lo = (cross << 32) | (loLo & 0xFFFFFFFFUL);
+            hi = hiHi + (hiLo >> 32) + (cross >> 32);
+        }
+
+        /// <summary>(hi:lo) + value</summary>
+        public static void Add(ref ulong hi, ref ulong lo, ulong value)
+        {
+            ulong newLo = lo + value;
+            if (newLo < lo) hi++;
+            lo = newLo;
+        }
+
+        /// <summary>(hi:lo) >> shift, 0 &lt;= shift &lt; 64</summary>
+        public static void ShiftRight(ref ulong hi, ref ulong lo, int shift)
+        {
+            if (shift == 0) return;
+            lo = (lo >> shift) | (hi << (64 - shift));
+            hi >>= shift;
+        }
+
+        /// <summary>
+        /// 128 by 64 bit unsigned division: (hi:lo) / divisor. Quotient is 128 bits (qHi:qLo). divisor must not be 0.
+        /// </summary>
+        public static void Divide(ulong hi, ulong lo, ulong divisor, out ulong qHi, out ulong qLo, out ulong remainder)
+        {
+            if (hi == 0)
+            {
+                qHi = 0;
+                qLo = lo / divisor;
+                remainder = lo % divisor;
+                return;
+            }
+
+            // Schoolbook binary long division. rem < divisor <= 2^64 - 1 at every step, carry handles the 65th bit.
+            ulong rem = 0;
+            qHi = 0;
+            qLo = 0;
+            for (int i = 127; i >= 0; i--)
+            {
+                ulong bit = i >= 64 ? (hi >> (i - 64)) & 1UL : (lo >> i) & 1UL;
+                bool carry = (rem >> 63) != 0;
+                rem = (rem << 1) | bit;
+
+                if (carry || rem >= divisor)
+                {
+                    rem -= divisor;
+                    if (i >= 64) qHi |= 1UL << (i - 64);
+                    else qLo |= 1UL << i;
+                }
+            }
+
+            remainder = rem;
+        }
+
+        /// <summary>floor(sqrt(hi:lo)), the result always fits in 64 bits.</summary>
+        public static ulong Sqrt(ulong hi, ulong lo)
+        {
+            if (hi == 0)
+                return Sqrt(lo);
+
+            // Newton iteration on 128 bits, starting from an over-estimate so the sequence decreases monotonically.
+            int bits = 128 - LeadingZeroCount(hi);
+            int shift = (bits + 1) / 2;
+            ulong x = shift >= 64 ? ulong.MaxValue : (1UL << shift);
+
+            while (true)
+            {
+                Divide(hi, lo, x, out ulong qHi, out ulong qLo, out _);
+                // y = (x + q) / 2 computed on 128 bits
+                ulong sumLo = qLo + x;
+                ulong sumHi = qHi + (sumLo < qLo ? 1UL : 0UL);
+                ulong y = (sumLo >> 1) | (sumHi << 63);
+                if ((sumHi >> 1) != 0) y = ulong.MaxValue;
+                if (y >= x) return x;
+                x = y;
+            }
+        }
+
+        /// <summary>floor(sqrt(n)) for 64-bit integers.</summary>
+        public static ulong Sqrt(ulong n)
+        {
+            if (n < 2) return n;
+
+            int shift = (64 - LeadingZeroCount(n) + 1) / 2;
+            ulong x = shift >= 64 ? ulong.MaxValue : 1UL << shift; // >= sqrt(n)
+            while (true)
+            {
+                ulong y = (x + n / x) >> 1;
+                if (x + n / x < x) y = (x >> 1) + ((n / x) >> 1) + 1; // overflow guard (only for huge n)
+                if (y >= x) return x;
+                x = y;
+            }
+        }
+
+        public static int LeadingZeroCount(ulong n)
+        {
+            if (n == 0) return 64;
+            int count = 0;
+            if ((n & 0xFFFFFFFF00000000UL) == 0) { count += 32; n <<= 32; }
+            if ((n & 0xFFFF000000000000UL) == 0) { count += 16; n <<= 16; }
+            if ((n & 0xFF00000000000000UL) == 0) { count += 8; n <<= 8; }
+            if ((n & 0xF000000000000000UL) == 0) { count += 4; n <<= 4; }
+            if ((n & 0xC000000000000000UL) == 0) { count += 2; n <<= 2; }
+            if ((n & 0x8000000000000000UL) == 0) { count += 1; }
+            return count;
+        }
+
+        /// <summary>|value| as an unsigned number (works for long.MinValue).</summary>
+        public static ulong Abs(long value) => value < 0 ? (ulong)(-(value + 1)) + 1UL : (ulong)value;
+    }
+}
diff --git a/AutomathonUnity/Assets/Core/Engine/Utility/IntMath.cs b/AutomathonUnity/Assets/Core/Engine/Utility/IntMath.cs
