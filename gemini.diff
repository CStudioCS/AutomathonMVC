+using Newtonsoft.Json;
+using System;
+using System.Globalization;
+
+namespace Automathon
+{
+    /// <summary>
+    /// Deterministic 32-bit signed fixed-point number in Q16.16 format (backed by <see cref="int"/>).
+    /// Range: [-32768.0, +32767.9999847412], resolution: 2^-16 (~1.5259e-5).
+    /// </summary>
+    [JsonConverter(typeof(FixedJsonConverter))]
+    public readonly struct Fixed : IEquatable<Fixed>, IComparable<Fixed>, IComparable, IFormattable
+    {
+        public const int FractionalBits = 16;
+        public const int OneRaw = 1 << FractionalBits; // 65536
+        private const int FractionMask = OneRaw - 1;
+        private const double ScaleDouble = OneRaw;
+        private const float ScaleFloat = OneRaw;
+        private const decimal ScaleDecimal = OneRaw;
+
+        public readonly int RawValue;
+
+        public static readonly Fixed Zero = new Fixed(0, true);
+        public static readonly Fixed One = new Fixed(OneRaw, true);
+        public static readonly Fixed MinusOne = new Fixed(-OneRaw, true);
+        public static readonly Fixed Half = new Fixed(OneRaw >> 1, true);
+        public static readonly Fixed Two = new Fixed(OneRaw << 1, true);
+        public static readonly Fixed Epsilon = new Fixed(1, true);
+        public static readonly Fixed MaxValue = new Fixed(int.MaxValue, true);
+        public static readonly Fixed MinValue = new Fixed(int.MinValue + 1, true); // symmetric saturating min (-int.MaxValue)
+
+        public static readonly Fixed Pi = new Fixed(205887, true);
+        public static readonly Fixed TwoPi = new Fixed(411775, true);
+        public static readonly Fixed HalfPi = new Fixed(102944, true);
+        public static readonly Fixed QuarterPi = new Fixed(51472, true);
+        public static readonly Fixed Deg2Rad = new Fixed(1144, true);
+        public static readonly Fixed Rad2Deg = new Fixed(3754936, true);
+
+        private Fixed(int rawValue, bool _)
+        {
+            RawValue = rawValue;
+        }
+
+        public static Fixed FromRaw(int rawValue) => new Fixed(rawValue, true);
+
+        public static Fixed FromInt(int value)
+        {
+            long shifted = (long)value << FractionalBits;
+            return new Fixed(ClampToInt32Symmetric(shifted), true);
+        }
+
+        public static Fixed FromLong(long value)
+        {
+            if (value > 32767L) return MaxValue;
+            if (value < -32767L) return MinValue;
+            return new Fixed(ClampToInt32Symmetric(value << FractionalBits), true);
+        }
+
+        public static Fixed FromFloat(float value)
+            => FromDouble(value);
+
+        public static Fixed FromDouble(double value)
+        {
+            if (double.IsNaN(value)) return Zero;
+            if (value >= (double)int.MaxValue / ScaleDouble) return MaxValue;
