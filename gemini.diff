+using System;
+
+namespace Automathon
+{
+    /// <summary>
+    /// Deterministic 2D vector using 32-bit <see cref="Fixed"/> (Q16.16) components,
+    /// with 64-bit <see cref="Fixed64"/> (Q32.32) intermediate precision for products, lengths, and projections.
+    /// </summary>
+    public struct Vector2Fixed : IEquatable<Vector2Fixed>
+    {
+        public Fixed X;
+        public Fixed Y;
+
+        public Vector2Fixed(Fixed x, Fixed y)
+        {
+            X = x;
+            Y = y;
+        }
+
+        public static Vector2Fixed Zero => new Vector2Fixed(Fixed.Zero, Fixed.Zero);
+        public static Vector2Fixed One => new Vector2Fixed(Fixed.One, Fixed.One);
+        public static Vector2Fixed Up => new Vector2Fixed(Fixed.Zero, Fixed.One);
+        public static Vector2Fixed Down => new Vector2Fixed(Fixed.Zero, Fixed.MinusOne);
+        public static Vector2Fixed Right => new Vector2Fixed(Fixed.One, Fixed.Zero);
+        public static Vector2Fixed Left => new Vector2Fixed(Fixed.MinusOne, Fixed.Zero);
+
+        public static Vector2Fixed operator +(Vector2Fixed a, Vector2Fixed b)
+            => new Vector2Fixed(a.X + b.X, a.Y + b.Y);
+
+        public static Vector2Fixed operator -(Vector2Fixed a, Vector2Fixed b)
+            => new Vector2Fixed(a.X - b.X, a.Y - b.Y);
+
+        public static Vector2Fixed operator -(Vector2Fixed a)
+            => new Vector2Fixed(-a.X, -a.Y);
+
+        public static Vector2Fixed operator *(Vector2Fixed a, Fixed b)
+            => new Vector2Fixed(a.X * b, a.Y * b);
+
+        public static Vector2Fixed operator *(Fixed a, Vector2Fixed b)
+            => new Vector2Fixed(a * b.X, a * b.Y);
+
+        public static Vector2Fixed operator /(Vector2Fixed a, Fixed b)
+            => new Vector2Fixed(a.X / b, a.Y / b);
+
+        public static bool operator ==(Vector2Fixed a, Vector2Fixed b)
+            => a.X == b.X && a.Y == b.Y;
+
+        public static bool operator !=(Vector2Fixed a, Vector2Fixed b)
+            => !(a == b);
+
+        public bool Equals(Vector2Fixed other) => this == other;
+        public override bool Equals(object obj) => obj is Vector2Fixed other && Equals(other);
+        public override int GetHashCode() => HashCode.Combine(X, Y);
+
+        public Fixed64 Dot64(Vector2Fixed other)
+            => (Fixed64)X * other.X + (Fixed64)Y * other.Y;
+
+        public Fixed Dot(Vector2Fixed other)
+            => Dot64(other).ToFixed();
+
+        public Fixed64 Cross64(Vector2Fixed other)
+            => (Fixed64)X * other.Y - (Fixed64)Y * other.X;
+
+        public Fixed Cross(Vector2Fixed other)
+            => Cross64(other).ToFixed();
+
+        public Fixed64 LengthSquared64()
+            => (Fixed64)X * X + (Fixed64)Y * Y;
+
+        public Fixed LengthSquared()
+            => LengthSquared64().ToFixed();
+
+        public Fixed64 Length64()
+            => FixedMath.Sqrt(LengthSquared64());
+
+        public Fixed Length()
+            => Length64().ToFixed();
+
+        public static Fixed Distance(Vector2Fixed a, Vector2Fixed b) => (a - b).Length();
+        public static Fixed64 DistanceSquared64(Vector2Fixed a, Vector2Fixed b) => (a - b).LengthSquared64();
+
+        public Vector2Fixed Normalized()
+        {
+            Fixed64 len = Length64();
+            if (len == Fixed64.Zero)
+                return Zero;
+            return new Vector2Fixed(((Fixed64)X / len).ToFixed(), ((Fixed64)Y / len).ToFixed());
+        }
+
+        public void Normalize()
+        {
+            this = Normalized();
+        }
+
+        public void NormalizeAtScale(Fixed scale)
+        {
+            Fixed64 len = Length64();
+            if (len == Fixed64.Zero)
+                return;
+            Fixed64 s = scale;
+            X = ((Fixed64)X * s / len).ToFixed();
+            Y = ((Fixed64)Y * s / len).ToFixed();
+        }
+
+        public static Vector2Fixed FromAngle(Fixed angleRadians)
+        {
+            FixedMath.SinCos(angleRadians, out Fixed64 sin, out Fixed64 cos);
+            return new Vector2Fixed(cos.ToFixed(), sin.ToFixed());
+        }
+
+        public Vector2Fixed OrthogonalClockwise() => new Vector2Fixed(Y, -X);
+        public Vector2Fixed OrthogonalCounterClockwise() => new Vector2Fixed(-Y, X);
+
+        public Vector2Fixed ProjectedOn(Vector2Fixed other)
+        {
+            Fixed64 otherLenSq = other.LengthSquared64();
+            if (otherLenSq == Fixed64.Zero)
+                return Zero;
+
+            Fixed64 dot = Dot64(other);
+            return new Vector2Fixed(
+                (dot * other.X / otherLenSq).ToFixed(),
+                (dot * other.Y / otherLenSq).ToFixed());
+        }
+
+        public Vector2Fixed ClipBetween(Vector2Fixed bound1, Vector2Fixed bound2)
+        {
+            Vector2Fixed edge = bound2 - bound1;
+            Fixed64 lenSq = edge.LengthSquared64();
+            if (lenSq == Fixed64.Zero)
+                return this;
+
+            Vector2Fixed rel = this - bound1;
+            Fixed64 scal = edge.Dot64(rel);
+            Vector2Fixed projOnNormal = rel.ProjectedOn(edge.OrthogonalCounterClockwise());
+
+            if (scal <= Fixed64.Zero)
+                return projOnNormal + bound1;
+            if (scal >= lenSq)
+                return projOnNormal + bound2;
+            return this;
+        }
+
+        public Vector2Fixed GetClosestOnLine(Vector2Fixed linePoint1, Vector2Fixed linePoint2)
+        {
+            Vector2Fixed edge = linePoint2 - linePoint1;
+            Fixed64 lenSq = edge.LengthSquared64();
+            if (lenSq == Fixed64.Zero)
+                return linePoint1;
+
+            Fixed64 scal = edge.Dot64(this - linePoint1);
+            if (scal <= Fixed64.Zero)
+                return linePoint1;
+            if (scal >= lenSq)
+                return linePoint2;
+
+            Fixed64 t = scal / lenSq;
+            return new Vector2Fixed(
+                ((Fixed64)linePoint1.X + t * edge.X).ToFixed(),
+                ((Fixed64)linePoint1.Y + t * edge.Y).ToFixed());
+        }
+
+        public static implicit operator Vector2Fixed(Vector2Int v) => new Vector2Fixed(v.X, v.Y);
+        public static explicit operator Vector2Int(Vector2Fixed v) => new Vector2Int((int)v.X, (int)v.Y);
+
+        public override string ToString() => $"({X}, {Y})";
+    }
+
+    /// <summary>
+    /// Deterministic 2D vector using 64-bit <see cref="Fixed64"/> (Q32.32) components.
+    /// </summary>
+    public struct Vector2Fixed64 : IEquatable<Vector2Fixed64>
+    {
+        public Fixed64 X;
+        public Fixed64 Y;
+
+        public Vector2Fixed64(Fixed64 x, Fixed64 y)
+        {
+            X = x;
+            Y = y;
+        }
+
+        public static Vector2Fixed64 Zero => new Vector2Fixed64(Fixed64.Zero, Fixed64.Zero);
+        public static Vector2Fixed64 One => new Vector2Fixed64(Fixed64.One, Fixed64.One);
+        public static Vector2Fixed64 Up => new Vector2Fixed64(Fixed64.Zero, Fixed64.One);
+        public static Vector2Fixed64 Right => new Vector2Fixed64(Fixed64.One, Fixed64.Zero);
+
+        public static Vector2Fixed64 operator +(Vector2Fixed64 a, Vector2Fixed64 b) => new Vector2Fixed64(a.X + b.X, a.Y + b.Y);
+        public static Vector2Fixed64 operator -(Vector2Fixed64 a, Vector2Fixed64 b) => new Vector2Fixed64(a.X - b.X, a.Y - b.Y);
+        public static Vector2Fixed64 operator -(Vector2Fixed64 a) => new Vector2Fixed64(-a.X, -a.Y);
+        public static Vector2Fixed64 operator *(Vector2Fixed64 a, Fixed64 b) => new Vector2Fixed64(a.X * b, a.Y * b);
+        public static Vector2Fixed64 operator *(Fixed64 a, Vector2Fixed64 b) => new Vector2Fixed64(a * b.X, a * b.Y);
+        public static Vector2Fixed64 operator /(Vector2Fixed64 a, Fixed64 b) => new Vector2Fixed64(a.X / b, a.Y / b);
+        public static bool operator ==(Vector2Fixed64 a, Vector2Fixed64 b) => a.X == b.X && a.Y == b.Y;
+        public static bool operator !=(Vector2Fixed64 a, Vector2Fixed64 b) => !(a == b);
+
+        public Fixed64 Dot(Vector2Fixed64 other) => X * other.X + Y * other.Y;
+        public Fixed64 Cross(Vector2Fixed64 other) => X * other.Y - Y * other.X;
+        public Fixed64 LengthSquared() => X * X + Y * Y;
+        public Fixed64 Length() => FixedMath.Sqrt(LengthSquared());
+
+        public Vector2Fixed64 Normalized()
+        {
+            Fixed64 len = Length();
+            return len == Fixed64.Zero ? Zero : this / len;
+        }
+
+        public static implicit operator Vector2Fixed64(Vector2Fixed v) => new Vector2Fixed64(v.X, v.Y);
+        public static explicit operator Vector2Fixed(Vector2Fixed64 v) => new Vector2Fixed(v.X.ToFixed(), v.Y.ToFixed());
+
+        public bool Equals(Vector2Fixed64 other) => this == other;
+        public override bool Equals(object obj) => obj is Vector2Fixed64 other && Equals(other);
+        public override int GetHashCode() => HashCode.Combine(X, Y);
+        public override string ToString() => $"({X}, {Y})";
+    }
+}
