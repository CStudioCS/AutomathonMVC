+using Automathon.Engine.Utility;
+using System;
+
+namespace Automathon
+{
+    /// <summary>
+    /// Deterministic integer-only mathematical library for <see cref="Fixed"/> (Q16.16)
+    /// and <see cref="Fixed64"/> (Q32.32). Zero runtime floating-point operations.
+    /// </summary>
+    public static class FixedMath
+    {
+        public static readonly Fixed Pi = Fixed.Pi;
+        public static readonly Fixed TwoPi = Fixed.TwoPi;
+        public static readonly Fixed HalfPi = Fixed.HalfPi;
+        public static readonly Fixed QuarterPi = Fixed.QuarterPi;
+        public static readonly Fixed Deg2Rad = Fixed.Deg2Rad;
+        public static readonly Fixed Rad2Deg = Fixed.Rad2Deg;
+
+        public static readonly Fixed64 Pi64 = Fixed64.Pi;
+        public static readonly Fixed64 TwoPi64 = Fixed64.TwoPi;
+        public static readonly Fixed64 HalfPi64 = Fixed64.HalfPi;
+        public static readonly Fixed64 QuarterPi64 = Fixed64.QuarterPi;
+
+        private const long CordicInvGainQ32 = 2608131496L; // round((1 / K_32) * 2^32)
+        private const long PiQ32 = 13493037705L;
+        private const long TwoPiQ32 = 26986075409L;
+        private const long HalfPiQ32 = 6746518852L;
+
+        private static readonly long[] AtanTableQ32 = new long[32]
+        {
+            3373259426L, 1991351318L, 1052175346L, 534100635L,
+            268086748L, 134174063L, 67103403L, 33553749L,
+            16777131L, 8388597L, 4194303L, 2097152L,
+            1048576L, 524288L, 262144L, 131072L,
+            65536L, 32768L, 16384L, 8192L,
+            4096L, 2048L, 1024L, 512L,
+            256L, 128L, 64L, 32L,
+            16L, 8L, 4L, 2L
+        };
+
+        // ---- Basic scalar functions ----
+        public static Fixed Abs(Fixed value) => value.RawValue < 0 ? -value : value;
+        public static Fixed64 Abs(Fixed64 value) => value.RawValue < 0 ? -value : value;
+
+        public static int Sign(Fixed value) => value.RawValue > 0 ? 1 : (value.RawValue < 0 ? -1 : 0);
+        public static int Sign(Fixed64 value) => value.RawValue > 0 ? 1 : (value.RawValue < 0 ? -1 : 0);
+
+        public static Fixed Min(Fixed a, Fixed b) => a.RawValue <= b.RawValue ? a : b;
+        public static Fixed64 Min(Fixed64 a, Fixed64 b) => a.RawValue <= b.RawValue ? a : b;
+
+        public static Fixed Max(Fixed a, Fixed b) => a.RawValue >= b.RawValue ? a : b;
+        public static Fixed64 Max(Fixed64 a, Fixed64 b) => a.RawValue >= b.RawValue ? a : b;
+
+        public static Fixed Clamp(Fixed value, Fixed min, Fixed max)
+            => value < min ? min : (value > max ? max : value);
+
+        public static Fixed64 Clamp(Fixed64 value, Fixed64 min, Fixed64 max)
+            => value < min ? min : (value > max ? max : value);
+
+        public static Fixed Clamp01(Fixed value) => Clamp(value, Fixed.Zero, Fixed.One);
+        public static Fixed64 Clamp01(Fixed64 value) => Clamp(value, Fixed64.Zero, Fixed64.One);
+
+        public static Fixed Floor(Fixed value) => Fixed.FromInt(value.FloorToInt());
+        public static Fixed Ceiling(Fixed value) => Fixed.FromInt(value.CeilToInt());
+        public static Fixed Round(Fixed value) => Fixed.FromInt(value.RoundToInt());
+
+        public static int FloorToInt(Fixed value) => value.FloorToInt();
+        public static int CeilToInt(Fixed value) => value.CeilToInt();
+        public static int RoundToInt(Fixed value) => value.RoundToInt();
+
+        public static Fixed Lerp(Fixed a, Fixed b, Fixed t) => a + (b - a) * Clamp01(t);
+        public static Fixed64 Lerp(Fixed64 a, Fixed64 b, Fixed64 t) => a + (b - a) * Clamp01(t);
+
+        public static Fixed MoveTowards(Fixed current, Fixed target, Fixed maxDelta)
+        {
+            Fixed diff = target - current;
+            if (Abs(diff) <= maxDelta) return target;
+            return current + Sign(diff) * maxDelta;
+        }
+
+        // ---- Angle helpers (symmetric [-Pi, +Pi]) ----
+        private static long ReduceAngleToMinusPiToPiQ32(long angleQ32)
+        {
+            long rem = angleQ32 % TwoPiQ32;
+            if (rem > PiQ32) rem -= TwoPiQ32;
+            else if (rem < -PiQ32) rem += TwoPiQ32;
+            return rem;
+        }
+
+        public static Fixed64 WrapAngle(Fixed64 radians)
+            => Fixed64.FromRaw(ReduceAngleToMinusPiToPiQ32(radians.RawValue));
+
+        public static Fixed WrapAngle(Fixed radians)
+            => WrapAngle((Fixed64)radians).ToFixed();
+
+        public static Fixed DeltaAngle(Fixed currentRadians, Fixed targetRadians)
+            => WrapAngle((Fixed64)targetRadians - currentRadians).ToFixed();
+
+        // ---- Square Root (pure integer, rounded to nearest bit) ----
+        public static Fixed Sqrt(Fixed value)
+        {
+            if (value.RawValue < 0)
+                throw new ArgumentOutOfRangeException(nameof(value), "Cannot take square root of negative Fixed value.");
+            if (value.RawValue == 0)
+                return Fixed.Zero;
+
+            // Shift by 18 bits so isqrt gives Q17, then +1 >> 1 rounds to nearest Q16!
+            ulong shifted = (ulong)value.RawValue << (Fixed.FractionalBits + 2);
+            ulong rootQ17 = IntMath.Isqrt(shifted);
+            return Fixed.FromRaw((int)((rootQ17 + 1UL) >> 1));
+        }
+
+        public static Fixed64 Sqrt(Fixed64 value)
+        {
+            if (value.RawValue < 0)
+                throw new ArgumentOutOfRangeException(nameof(value), "Cannot take square root of negative Fixed64 value.");
+            if (value.RawValue == 0)
+                return Fixed64.Zero;
+
+            // Compute exact integer floor(sqrt(raw << 34)) (98-bit unsigned integer) using digit-by-digit 128-bit isqrt,
+            // then round to nearest bit via (rootQ33 + 1) >> 1 -> 0.5-ULP exact Q32.32 across full 64-bit range!
+            ulong raw = (ulong)value.RawValue;
+            ulong hi = raw >> 30;      // bits 64..97 of (raw << 34)
+            ulong lo = raw << 34;      // bits 0..63 of (raw << 34)
+
+            ulong remHi = 0UL;
+            ulong remLo = 0UL;
+            ulong root = 0UL;
+
+            for (int pair = 48; pair >= 0; pair--)
+            {
+                int bitPos = pair * 2;
+                ulong twoBits = bitPos >= 64
+                    ? (hi >> (bitPos - 64)) & 3UL
+                    : (lo >> bitPos) & 3UL;
+
+                remHi = (remHi << 2) | (remLo >> 62);
+                remLo = (remLo << 2) | twoBits;
+
+                // Candidate divisor = (root << 2) | 1 (66-bit at most since root <= 2^49)
+                ulong candHi = root >> 62;
+                ulong candLo = (root << 2) | 1UL;
+
+                root <<= 1;
+                if (remHi > candHi || (remHi == candHi && remLo >= candLo))
+                {
+                    if (remLo < candLo) remHi--;
+                    remLo -= candLo;
+                    remHi -= candHi;
+                    root |= 1UL;
+                }
+            }
+
+            long rounded = (long)((root + 1UL) >> 1);
+            return Fixed64.FromRaw(rounded);
+        }
+
+        // ---- Sin / Cos / Tan via 32-iteration Q32.32 CORDIC rotation mode ----
+        public static void SinCos(Fixed64 radians, out Fixed64 sin, out Fixed64 cos)
+        {
+            long z = ReduceAngleToMinusPiToPiQ32(radians.RawValue);
+
+            // Reduce from [-pi, +pi] into [-pi/2, +pi/2] using symmetric reflection
+            bool flipSign = false;
+            if (z > HalfPiQ32)
+            {
+                z = PiQ32 - z;
+                flipSign = true;
+            }
+            else if (z < -HalfPiQ32)
+            {
+                z = -PiQ32 - z;
+                flipSign = true;
+            }
+
+            long x = CordicInvGainQ32;
+            long y = 0L;
+
+            for (int i = 0; i < 32; i++)
+            {
+                long xNew, yNew;
+                long dx = x >> i;
+                long dy = y >> i;
+                if (z >= 0)
+                {
+                    xNew = x - dy;
+                    yNew = y + dx;
+                    z -= AtanTableQ32[i];
+                }
+                else
+                {
+                    xNew = x + dy;
+                    yNew = y - dx;
+                    z += AtanTableQ32[i];
+                }
+                x = xNew;
+                y = yNew;
+            }
+
+            if (flipSign)
+                x = -x;
+
+            // Clamp tightly within [-1.0, +1.0] in Q32.32
+            if (x > Fixed64.OneRaw) x = Fixed64.OneRaw;
+            else if (x < -Fixed64.OneRaw) x = -Fixed64.OneRaw;
+
+            if (y > Fixed64.OneRaw) y = Fixed64.OneRaw;
+            else if (y < -Fixed64.OneRaw) y = -Fixed64.OneRaw;
+
+            cos = Fixed64.FromRaw(x);
+            sin = Fixed64.FromRaw(y);
+        }
+
+        public static Fixed64 Cos(Fixed64 radians)
+        {
+            SinCos(radians, out _, out Fixed64 c);
+            return c;
+        }
+
+        public static Fixed64 Sin(Fixed64 radians)
+        {
+            SinCos(radians, out Fixed64 s, out _);
+            return s;
+        }
+
+        public static Fixed Cos(Fixed radians) => Cos((Fixed64)radians).ToFixed();
+        public static Fixed Sin(Fixed radians) => Sin((Fixed64)radians).ToFixed();
+
+        public static Fixed64 Tan(Fixed64 radians)
+        {
+            SinCos(radians, out Fixed64 s, out Fixed64 c);
+            return s / c;
+        }
+
+        public static Fixed Tan(Fixed radians) => Tan((Fixed64)radians).ToFixed();
+
+        // ---- Atan2 / Atan / Asin / Acos via 32-iteration Q32.32 CORDIC vectoring mode ----
+        public static Fixed64 Atan2(Fixed64 y, Fixed64 x)
+        {
+            long xv = x.RawValue;
+            long yv = y.RawValue;
+            if (xv == long.MinValue) xv = -long.MaxValue;
+            if (yv == long.MinValue) yv = -long.MaxValue;
+
+            if (xv == 0L)
+            {
+                if (yv > 0L) return Fixed64.HalfPi;
+                if (yv < 0L) return -Fixed64.HalfPi;
+                return Fixed64.Zero;
+            }
+
+            if (yv == 0L)
+            {
+                return xv > 0L ? Fixed64.Zero : Fixed64.Pi;
+            }
+
+            // Work in first/fourth quadrant with rx > 0
+            bool negX = xv < 0L;
+            long rx = negX ? -xv : xv;
+            long ry = negX ? -yv : yv;
+
+            // Normalize magnitude near 2^56 to maximize 64-bit precision without CORDIC gain overflow (< 1.65 * max)
+            long absY = ry < 0L ? -ry : ry;
+            long maxAbs = rx > absY ? rx : absY;
+            while (maxAbs < (1L << 56) && maxAbs > 0L)
+            {
+                rx <<= 1;
+                ry <<= 1;
+                maxAbs <<= 1;
+            }
+            while (maxAbs > (1L << 60))
+            {
+                rx >>= 1;
+                ry >>= 1;
+                maxAbs >>= 1;
+            }
+
+            long angleQ32 = 0L;
+            for (int i = 0; i < 32; i++)
+            {
+                long xNew, yNew;
+                if (ry > 0L)
+                {
+                    xNew = rx + (ry >> i);
+                    yNew = ry - (rx >> i);
+                    angleQ32 += AtanTableQ32[i];
+                }
+                else
+                {
+                    xNew = rx - (ry >> i);
+                    yNew = ry + (rx >> i);
+                    angleQ32 -= AtanTableQ32[i];
+                }
+                rx = xNew;
+                ry = yNew;
+            }
+
+            if (angleQ32 > HalfPiQ32) angleQ32 = HalfPiQ32;
+            else if (angleQ32 < -HalfPiQ32) angleQ32 = -HalfPiQ32;
+
+            if (!negX)
+                return Fixed64.FromRaw(angleQ32);
+
+            return yv >= 0L
+                ? Fixed64.FromRaw(angleQ32 + PiQ32)
+                : Fixed64.FromRaw(angleQ32 - PiQ32);
+        }
+
+        public static Fixed Atan2(Fixed y, Fixed x)
+            => Atan2((Fixed64)y, (Fixed64)x).ToFixed();
+
+        public static Fixed64 Atan(Fixed64 x) => Atan2(x, Fixed64.One);
+        public static Fixed Atan(Fixed x) => Atan2((Fixed64)x, Fixed64.One).ToFixed();
+
+        public static Fixed64 Asin(Fixed64 x)
+        {
+            x = Clamp(x, Fixed64.MinusOne, Fixed64.One);
+            Fixed64 cos = Sqrt(Fixed64.One - x * x);
+            return Atan2(x, cos);
+        }
+
+        public static Fixed Asin(Fixed x) => Asin((Fixed64)x).ToFixed();
+
+        public static Fixed64 Acos(Fixed64 x)
+        {
+            x = Clamp(x, Fixed64.MinusOne, Fixed64.One);
+            Fixed64 sin = Sqrt(Fixed64.One - x * x);
+            return Atan2(sin, x);
+        }
+
+        public static Fixed Acos(Fixed x) => Acos((Fixed64)x).ToFixed();
+    }
+}
